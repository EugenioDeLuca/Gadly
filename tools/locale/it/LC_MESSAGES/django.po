msgstr "testo che è stato rimosso."

#: .\tools\templates\tools\help_diff_checker.html:45
#: .\tools\templates\tools\qr_generator.html:336
msgid "Green"
msgstr "Verde"

#: .\tools\templates\tools\help_diff_checker.html:45
