#: .\tools\templates\tools\help_data_viz.html:5
#: .\tools\templates\tools\help_data_viz.html:39
msgid "Data Visualizer guide"
msgstr "Guida \"Grafici\""

#: .\tools\templates\tools\help_data_viz.html:8
msgid ""
"How to format CSV data, load Excel files, and create charts with Gadly’s "
"Data Visualizer."
msgstr ""
"Come formattare dati CSV, caricare file Excel e creare grafici con "
"\"Grafici\" di Gadly."

#: .\tools\templates\tools\help_data_viz.html:40
msgid ""
"Format your data, pick a chart type, and export images — all in your browser."
msgstr ""
"Formatta i dati, scegli il tipo di grafico ed esporta le immagini — tutto "
"nel browser."

#: .\tools\templates\tools\help_data_viz.html:43
msgid "CSV format"
msgstr "Formato CSV"

#: .\tools\templates\tools\help_data_viz.html:44
msgid "One row per item. Use a comma, semicolon, or tab between columns."
msgstr ""
"Una riga per elemento. Usa virgola, punto e virgola o tab tra le colonne."

#: .\tools\templates\tools\help_data_viz.html:48
msgid "For multiple series, add more value columns:"
msgstr "Per più serie, aggiungi altre colonne valore:"

#: .\tools\templates\tools\help_data_viz.html:55
msgid "Excel files"
msgstr "File Excel"

#: .\tools\templates\tools\help_data_viz.html:56
msgid ""
"Load .xlsx or .xls directly, or download a template, edit in Excel/"
"LibreOffice, and reload. Files never leave your device."
msgstr ""
"Carica .xlsx o .xls direttamente, oppure scarica un template, modificalo in "
"Excel/LibreOffice e ricaricalo. I file non lasciano mai il tuo dispositivo."

#: .\tools\templates\tools\help_data_viz.html:62
msgid "Chart title — shown on the chart and included in exports."
msgstr "Titolo grafico — mostrato sul grafico e incluso negli export."

#: .\tools\templates\tools\help_data_viz.html:63
msgid "Color palette — Gadly, pastel, high contrast, or blue mono."
msgstr "Palette colori — Gadly, pastello, alto contrasto o blu monocromatico."

#: .\tools\templates\tools\help_data_viz.html:64
msgid "Sort data — by label or total value before drawing."
msgstr "Ordina dati — per etichetta o valore totale prima di disegnare."

#: .\tools\templates\tools\help_data_viz.html:65
msgid "Top N — for pie charts, group smaller slices into “Other”."
msgstr "Top N — per le torte, raggruppa le fette più piccole in «Altro»."

#: .\tools\templates\tools\help_data_viz.html:66
msgid "Show values — display numbers on bars or pie slices."
msgstr "Mostra valori — numeri su barre o fette della torta."

#: .\tools\templates\tools\help_data_viz.html:67
msgid "Horizontal bars — useful for long category names."
msgstr "Barre orizzontali — utili per nomi di categoria lunghi."

#: .\tools\templates\tools\help_data_viz.html:68
msgid "Suggest chart type — auto-picks bar, line, or pie from your data."
msgstr ""
"Suggerisci tipo di grafico — sceglie automaticamente barre, linee o torta in "
"base ai dati."

#: .\tools\templates\tools\help_data_viz.html:73
msgid "Export & share"
msgstr "Export e condivisione"

#: .\tools\templates\tools\help_data_viz.html:74
msgid ""
"Download PNG, SVG, or PDF after generating a chart. Use “Copy link” to save "
"your dataset and settings in the URL (best for small datasets)."
msgstr ""
"Dopo aver generato un grafico, scarica PNG, SVG o PDF. Usa «Copia link» per "
"salvare dati e impostazioni nell'URL (ideale per dataset piccoli)."

#: .\tools\templates\tools\help_data_viz.html:78
msgid "Common issues"
msgstr "Problemi comuni"

#: .\tools\templates\tools\help_data_viz.html:80
msgid ""
"Use numbers with a dot or comma decimal separator (e.g. 1.234,56 or 1234.56)."
msgstr ""
"Usa numeri con separatore decimale punto o virgola (es. 1.234,56 o 1234.56)."

#: .\tools\templates\tools\help_data_viz.html:81
msgid "Remove empty rows and extra columns you do not need."
msgstr "Rimuovi righe vuote e colonne superflue."

#: .\tools\templates\tools\help_data_viz.html:82
msgid "If Excel shows dates as numbers, format cells as text or export as CSV."
msgstr ""
"Se Excel mostra le date come numeri, formatta le celle come testo o esporta "
"in CSV."

#: .\tools\templates\tools\help_data_viz.html:87
msgid "Back to \"Data Visualizer\""
msgstr "Torna a \"Grafici\""

