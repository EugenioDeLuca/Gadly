"Accedi per gestire il tuo account e continuare a usare gli strumenti Gadly."

#: .\tools\templates\registration\login.html:27
#: .\tools\templates\tools\account_profile.html:62
#: .\tools\templates\tools\register.html:33
msgid "Username"
msgstr "Nome utente"

#: .\tools\templates\registration\login.html:35
#: .\tools\templates\tools\account_profile.html:85
msgid "Password"
msgstr "Password"

#: .\tools\templates\registration\login.html:40
#: .\tools\templates\registration\password_reset_complete.html:19
#: .\tools\templates\registration\password_reset_confirm.html:57
#: .\tools\templates\tools\register.html:67
#: .\tools\templates\tools\request_verification_email.html:33
#: .\tools\templates\tools\verify_email_invalid.html:23
msgid "Sign in"
msgstr "Accedi"

#: .\tools\templates\registration\login.html:44
msgid "Forgot password?"
msgstr "Password dimenticata?"

#: .\tools\templates\registration\login.html:47
msgid "Didn't receive the verification email?"
msgstr "Non hai ricevuto l'email di verifica?"

#: .\tools\templates\registration\login.html:49
