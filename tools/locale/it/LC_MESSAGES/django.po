msgstr "testo che è stato aggiunto."

#: .\tools\templates\tools\help_diff_checker.html:50
msgid "Best practices"
msgstr "Buone pratiche"

#: .\tools\templates\tools\help_diff_checker.html:51
msgid ""
"Paste the original text on the left and the modified text on the right. "
"Small, focused changes are easier to read than very large blocks of text."
msgstr ""
"Incolla il testo originale a sinistra e il testo modificato a destra. "
"Modifiche piccole e mirate sono più facili da leggere rispetto a blocchi "
