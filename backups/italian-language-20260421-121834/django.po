msgstr "Nessun parlato rilevato. Riprova."

msgid "Could not use the microphone. Check permissions."
msgstr "Impossibile utilizzare il microfono. Controlla i permessi."

msgid "Voice input is not available."
msgstr "L'input vocale non è disponibile."

msgid "Could not start listening. Try again in a moment."
msgstr "Impossibile iniziare l'ascolto. Riprova tra un attimo."

