#: tools/static/tools/js/application_email_generator.js:25
msgid "Please fill in name, role, and company."
msgstr "Compila nome, ruolo e azienda."

#: tools/static/tools/js/application_email_generator.js:31
msgid ""
"Relevant experience, strong communication, and motivation for the role."
msgstr ""
"Esperienza pertinente, comunicazione efficace e motivazione per il ruolo."

#: tools/static/tools/js/application_email_generator.js:33
msgid "Application for %(role)s - %(name)s"
msgstr "Candidatura per %(role)s - %(name)s"

#: tools/static/tools/js/application_email_generator.js:38
msgid "Subject"
msgstr "Oggetto"

#: tools/static/tools/js/application_email_generator.js:40
msgid "Dear Hiring Team"
msgstr "Gentile team HR"

#: tools/static/tools/js/application_email_generator.js:42
msgid "I am applying for the %(role)s role at %(company)s."
msgstr "Mi candido per il ruolo di %(role)s presso %(company)s."

#: tools/static/tools/js/application_email_generator.js:45
msgid "I believe my profile is a strong fit. Key points: %(points)s"
msgstr "Ritengo che il mio profilo sia adatto. Punti chiave: %(points)s"

#: tools/static/tools/js/application_email_generator.js:47
msgid "I have attached my CV and would be glad to discuss my application."
msgstr "Ho allegato il mio CV e sarei lieto di discutere la mia candidatura."

#: tools/static/tools/js/application_email_generator.js:49
msgid "Kind regards"
msgstr "Cordiali saluti"

msgid "Application: %(role)s position — %(name)s"
msgstr "Candidatura: posizione %(role)s — %(name)s"

msgid "%(name)s — application for %(role)s"
msgstr "%(name)s — candidatura per %(role)s"

msgid "Dear Recruiting Team"
msgstr "Gentile team di selezione"

msgid "Hello"
msgstr "Salve"

msgid "I am writing to apply for the %(role)s position at %(company)s."
msgstr "Scrivo per candidarmi alla posizione di %(role)s presso %(company)s."

msgid ""
"I would like to express my interest in the %(role)s role at %(company)s."
msgstr ""
"Vorrei esprimere il mio interesse per il ruolo di %(role)s presso "
"%(company)s."

msgid "Here is a brief summary of how I match the role: %(points)s"
msgstr "Ecco un breve riepilogo di come rispondo al ruolo: %(points)s"

msgid "My strengths for this position include: %(points)s"
msgstr "I miei punti di forza per questa posizione includono: %(points)s"

msgid ""
"Please find my CV attached; I would welcome the opportunity to discuss my "
"application."
msgstr ""
"In allegato il mio CV; accoglierei volentieri l’occasione di discutere la "
"mia candidatura."

msgid ""
"My CV is attached for your review. I would be happy to discuss how I can "
"contribute."
msgstr ""
"Il mio CV è in allegato per la sua valutazione. Sarò lieto di discutere come"
" posso contribuire."

msgid "Best regards"
msgstr "Cordiali saluti"

msgid "Sincerely"
msgstr "Cordialmente"

