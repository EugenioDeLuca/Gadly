#: tools/static/tools/js/interview_simulator.js:32
msgid "Mid"
msgstr "Intermedio"

#: tools/static/tools/js/interview_simulator.js:36
msgid "Please enter a target role."
msgstr "Inserisci un ruolo target."

#: tools/static/tools/js/interview_simulator.js:40
msgid "problem solving, teamwork, and communication"
msgstr "problem solving, lavoro di squadra e comunicazione"

#: tools/static/tools/js/interview_simulator.js:43
msgid "Tell me about yourself and why you are interested in this role."
msgstr "Parlami di te e del motivo per cui ti interessa questo ruolo."

#: tools/static/tools/js/interview_simulator.js:44
msgid "Describe a challenging project and your contribution."
msgstr "Descrivi un progetto sfidante e il tuo contributo."

#: tools/static/tools/js/interview_simulator.js:45
msgid "How do you prioritize tasks when deadlines overlap?"
msgstr "Come dai priorita alle attivita quando le scadenze si sovrappongono?"

#: tools/static/tools/js/interview_simulator.js:46
msgid "What would your previous manager say about your strengths?"
msgstr "Cosa direbbe il tuo precedente manager sui tuoi punti di forza?"

#: tools/static/tools/js/interview_simulator.js:47
msgid "How would you approach this role in the first 90 days?"
msgstr "Come affronteresti questo ruolo nei primi 90 giorni?"

#: tools/static/tools/js/interview_simulator.js:48
msgid "What interests you about our company or this industry?"
msgstr "Cosa ti interessa della nostra azienda o di questo settore?"

#: tools/static/tools/js/interview_simulator.js:49
msgid "Describe a conflict or disagreement at work and how you handled it."
msgstr ""
"Descrivi un conflitto o un disaccordo sul lavoro e come lo hai gestito."

#: tools/static/tools/js/interview_simulator.js:50
msgid "How do you keep your skills up to date for this kind of role?"
msgstr "Come tieni aggiornate le competenze per questo tipo di ruolo?"

#: tools/static/tools/js/interview_simulator.js:53
msgid ""
"Keep your answer concise: profile, relevant experience, and motivation."
msgstr ""
"Mantieni la risposta concisa: profilo, esperienza rilevante e motivazione."

#: tools/static/tools/js/interview_simulator.js:54
msgid "Use STAR: Situation, Task, Action, Result with measurable impact."
msgstr ""
"Usa STAR: Situazione, Compito, Azione, Risultato con impatto misurabile."

#: tools/static/tools/js/interview_simulator.js:55
msgid "Explain your prioritization method and communication style."
msgstr "Spiega il tuo metodo di prioritizzazione e il tuo stile comunicativo."

#: tools/static/tools/js/interview_simulator.js:56
msgid "Highlight two strengths with concrete examples."
msgstr "Evidenzia due punti di forza con esempi concreti."

#: tools/static/tools/js/interview_simulator.js:57
msgid "Show a realistic plan: learn, align, deliver quick wins."
msgstr ""
"Mostra un piano realistico: apprendere, allinearsi, ottenere risultati "
"rapidi."

#: tools/static/tools/js/interview_simulator.js:58
msgid "Mention something specific you learned about the company or sector."
msgstr "Cita qualcosa di specifico che hai appreso su azienda o settore."

#: tools/static/tools/js/interview_simulator.js:59
msgid "Emphasize listening, clarity, and a constructive outcome."
msgstr "Metti in evidenza ascolto, chiarezza e un esito costruttivo."

#: tools/static/tools/js/interview_simulator.js:60
msgid "Name learning habits: courses, reading, side projects, or communities."
msgstr ""
"Indica abitudini di apprendimento: corsi, letture, progetti personali, "
"community."

